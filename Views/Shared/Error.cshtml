@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<section class="card"><h1>No pudimos procesar la solicitud</h1><p>Intenta nuevamente. Si el problema continúa, proporciona esta referencia a soporte.</p>
@if (Model.ShowRequestId) { <p><strong>Referencia:</strong> <code>@Model.RequestId</code></p> }
<a class="button" asp-controller="Incidentes" asp-action="Index">Volver al panel</a></section>
